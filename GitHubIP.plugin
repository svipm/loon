[Script]

# Benchmark selectable public mirrors, then cache the fastest one for Auto mode.
cron "0 */6 * * *" script-path=https://gh-proxy.com/https://raw.githubusercontent.com/svipm/loon/main/scripts/github-download-proxy-auto.js,timeout=30,tag=GitHub Proxy Auto Select,enable=true
network-changed script-path=https://gh-proxy.com/https://raw.githubusercontent.com/svipm/loon/main/scripts/github-download-proxy-auto.js,timeout=30,tag=GitHub Proxy Auto Select,enable=true

# Public raw/release/archive/codeload/gist downloads.
http-request ^https?:\/\/(raw\.githubusercontent\.com|codeload\.github\.com|gist\.githubusercontent\.com)\/|^https?:\/\/github\.com\/[^\/]+\/[^\/]+\/(releases\/download|archive\/refs)\/ script-path=https://gh-proxy.com/https://raw.githubusercontent.com/svipm/loon/main/scripts/github-download-proxy-auto.js,timeout=10,tag=GitHub Download Proxy,enable=true

[MITM]
hostname = raw.githubusercontent.com, github.com, codeload.github.com, gist.githubusercontent.com
