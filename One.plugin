#!name=一个(o*N) 去广告解锁
#!desc=兼容0325api；清空ad/space；关开屏/弹窗/我的页弹层；VIP解锁 2026.07.19 fix2
#!icon=https://raw.githubusercontent.com/Yu9191/Rewrite/main/icon.png

[Rewrite]
# 广告素材
^https?:\/\/[^\/]+\/storage\/commercial\/ - reject
# 广告 HLS 视频
^https?:\/\/[^\/]+\/encry\/ad\/ - reject
# 游戏奖励弹窗图
^https?:\/\/[^\/]+\/storage\/game_bonus\/ - reject

[Script]
# 一个脚本：去广告 / VIP / 解锁 / token / 我的页弹窗
http-response ^https?:\/\/[^\/]+\/v2\.5\/(?:bootstrap|user\/login|user\/avatarFrame|user\/oneLiveInfo|article\/discovery|article\/day|navigation|ad\/space|my\/userExtraInfo|my\/unread|popup\/activityInfo|vip\/getVipGiftPopup|panda\/popup|upgrade|activityNavigations|blindBox\/getOngoingActivities) script-path=https://raw.githubusercontent.com/svipm/loon/refs/heads/main/One1222.fixed.js, requires-body=true, timeout=60, tag=一个-响应改写
http-request ^https?:\/\/[^\/]+\/v2\.5\/article\/detail script-path=https://raw.githubusercontent.com/svipm/loon/refs/heads/main/One1222.fixed.js, timeout=60, tag=一个-token

[MITM]
hostname = 0325api.*, api.*, jmtp.*, qqcapi.*, *api*.*, *jmtp*.*, ysp*.*, jmt*.*, enimg*.*, dlmk*.*, *scycjz.com, *rjpdf.com, *xqjby.com, *alovecdn.com, *b675211.com, *vf5x3hv.com
