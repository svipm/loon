#!name=GitHub Raw & Download 加速
#!desc=仅使用 gh-proxy.com 加速 GitHub Raw 文件和下载文件，不处理 blob/API/普通页面
#!author=local

[URL Rewrite]

# raw.githubusercontent.com 原始文件
# 例如：https://raw.githubusercontent.com/user/repo/main/file.txt
# 例如：https://raw.githubusercontent.com/user/repo/refs/heads/main/file.txt
^https?:\/\/raw\.githubusercontent\.com\/(.+)$ https://gh-proxy.com/https://raw.githubusercontent.com/$1 302


[MITM]
hostname = raw.githubusercontent.com, github.com
