#!name=GitHub Fast DoH
#!desc=Use DoH for GitHub domains and optionally proxy public GitHub downloads. For study only.
#!author=svipm
#!tag=GitHub,DNS,DoH,Download
#!homepage=https://github.com/svipm/loon
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/GitHub.png
#!date=2026-07-07 17:33:06
#!select=代理模式,Auto,ghproxy.net,gh-proxy.com,gh.3w.pm
#!warning=For study and personal testing only. Delete within 24 hours. Do not use for illegal, infringing, unauthorized, commercial, or abusive purposes. Use at your own risk.
#!notice=Recommended single GitHub plugin. Do not enable together with GitHubIP.plugin or FzjexGitHubDoH.plugin during troubleshooting.

# 声明：本插件仅供学习、研究、技术交流和个人合法网络环境测试使用。
# 请在下载、导入、订阅或启用后的 24 小时内自行删除、卸载或取消订阅。
# 严禁用于违法违规、侵权、未授权访问、绕过平台限制、商业倒卖或任何不正当用途。
# 本插件只处理 GitHub 相关域名解析和公开下载链接辅助，不提供访问授权、账号权限绕过或私有资源获取能力。
# GitHub 页面/API/静态资源域名使用 https://doh.pub/dns-query 进行 DoH 解析，降低本地 DNS 污染影响。
# raw/release/archive/codeload/gist 等公开下载链接可按插件参数选择公益代理；Auto 会定时测速并缓存较快代理。
# 请勿通过第三方代理访问私有仓库、登录态请求、Cookie、Token、鉴权链接或任何敏感内容。
# 第三方 DoH 与公益代理可能记录请求信息、限流、失效或返回异常；使用风险由使用者自行承担。

[host]
github.com = server:https://doh.pub/dns-query
*.github.com = server:https://doh.pub/dns-query
githubusercontent.com = server:https://doh.pub/dns-query
*.githubusercontent.com = server:https://doh.pub/dns-query
githubassets.com = server:https://doh.pub/dns-query
*.githubassets.com = server:https://doh.pub/dns-query
github.io = server:https://doh.pub/dns-query
*.github.io = server:https://doh.pub/dns-query
github.blog = server:https://doh.pub/dns-query
github.community = server:https://doh.pub/dns-query
githubstatus.com = server:https://doh.pub/dns-query
raw.githubusercontent.com = server:https://doh.pub/dns-query
gist.githubusercontent.com = server:https://doh.pub/dns-query
codeload.github.com = server:https://doh.pub/dns-query
objects.githubusercontent.com = server:https://doh.pub/dns-query
release-assets.githubusercontent.com = server:https://doh.pub/dns-query
github-releases.githubusercontent.com = server:https://doh.pub/dns-query
private-user-images.githubusercontent.com = server:https://doh.pub/dns-query
user-images.githubusercontent.com = server:https://doh.pub/dns-query
media.githubusercontent.com = server:https://doh.pub/dns-query
avatars.githubusercontent.com = server:https://doh.pub/dns-query
avatars0.githubusercontent.com = server:https://doh.pub/dns-query
avatars1.githubusercontent.com = server:https://doh.pub/dns-query
avatars2.githubusercontent.com = server:https://doh.pub/dns-query
avatars3.githubusercontent.com = server:https://doh.pub/dns-query
avatars4.githubusercontent.com = server:https://doh.pub/dns-query
avatars5.githubusercontent.com = server:https://doh.pub/dns-query
camo.githubusercontent.com = server:https://doh.pub/dns-query
cloud.githubusercontent.com = server:https://doh.pub/dns-query
desktop.githubusercontent.com = server:https://doh.pub/dns-query
favicons.githubusercontent.com = server:https://doh.pub/dns-query
pipelines.actions.githubusercontent.com = server:https://doh.pub/dns-query
alive.github.com = server:https://doh.pub/dns-query
api.github.com = server:https://doh.pub/dns-query
gist.github.com = server:https://doh.pub/dns-query
docs.github.com = server:https://doh.pub/dns-query
pages.github.com = server:https://doh.pub/dns-query
support.github.com = server:https://doh.pub/dns-query
education.github.com = server:https://doh.pub/dns-query
enterprise.github.com = server:https://doh.pub/dns-query
copilot.github.com = server:https://doh.pub/dns-query
central.github.com = server:https://doh.pub/dns-query
collector.github.com = server:https://doh.pub/dns-query
live.github.com = server:https://doh.pub/dns-query
api.individual.githubcopilot.com = server:https://doh.pub/dns-query
vscode.dev = server:https://doh.pub/dns-query

[Script]

# Benchmark selectable public mirrors, then cache the fastest one for Auto mode.
cron "0 */6 * * *" script-path=https://gh-proxy.com/https://raw.githubusercontent.com/svipm/loon/main/scripts/github-download-proxy-auto.js,timeout=30,tag=GitHub Proxy Auto Select,enable=true
network-changed script-path=https://gh-proxy.com/https://raw.githubusercontent.com/svipm/loon/main/scripts/github-download-proxy-auto.js,timeout=30,tag=GitHub Proxy Auto Select,enable=true

# Public raw/release/archive/codeload/gist downloads only. Keep private or sensitive URLs away from third-party proxy services.
http-request ^https?:\/\/(raw\.githubusercontent\.com|codeload\.github\.com|gist\.githubusercontent\.com)\/|^https?:\/\/github\.com\/[^\/]+\/[^\/]+\/(releases\/download|archive\/refs)\/ script-path=https://gh-proxy.com/https://raw.githubusercontent.com/svipm/loon/main/scripts/github-download-proxy-auto.js,timeout=10,tag=GitHub Download Proxy,enable=true

[MITM]
hostname = raw.githubusercontent.com, github.com, codeload.github.com, gist.githubusercontent.com
